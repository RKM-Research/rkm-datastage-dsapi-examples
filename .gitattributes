# UTF-8 text is stored with LF in Git and checked out with Windows CRLF where appropriate
* text=auto

# Windows source, project files, and documentation
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.xaml text eol=crlf
*.resx text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.svg text eol=crlf
*.plist text eol=crlf
*.config text eol=crlf
*.ini text eol=crlf
*.ps1 text eol=crlf

# Cross-platform scripts, CI workflows, and Git configuration
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf

# Preserve binary assets exactly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.zip binary
*.pdf binary
*.dll binary
*.exe binary
*.pdb binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
